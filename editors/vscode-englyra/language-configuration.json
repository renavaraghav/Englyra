{
  "comments": {"lineComment": "#"},
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    {"open": "\"", "close": "\"", "notIn": ["string", "comment"]},
    {"open": "(", "close": ")"},
    {"open": "[", "close": "]"},
    {"open": "{", "close": "}"}
  ],
  "surroundingPairs": [["\"", "\""], ["(", ")"], ["[", "]"], ["{", "}"]],
  "folding": {
    "markers": {
      "start": "^\\s*(if\\b|repeat\\b)",
      "end": "^\\s*(end if|end repeat)\\s*$"
    }
  }
}
